params {
// input
    input    = "samplesheet_full.csv"
    cram_dir = null

// igenomes
    igenomes_base   = '/lustre/imgge/db/igenomes_nf'
    genome          = 'NCBI.GRCh38'
    bwa             = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38/Sequence/BWAIndex/version0.6.0/"
    fasta           = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa"
    fasta_fai       = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa.fai"
    dict            = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.dict"
    ngscheckmate_bed = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38/Annotation/NGSCheckMate/SNP_GRCh38_hg38_wChr.bed"

    // Preprocessing
    trim_fastq         = true
    aligner            = 'bwa-mem'        // Default is bwa-mem, bwa-mem2 and dragmap can be used too
    use_gatk_spark     = 'markduplicates' // GATK Spark implementation
    save_mapped        = true            // Mapped BAMs not saved

    // VEP
    vep_cache        = '/lustre/imgge/db/vep'
    snpeff_cache     = null
    vep_cache_version = 113
    vep_genome       = 'GRCh38'
    vep_species      = 'homo_sapiens'

    // default params
    no_intervals = true

    tools      = 'deepvariant'
    skip_tools = 'fastqc,markduplicates,baserecalibrator'
}

profiles {
    singularity {
        enabled   = true
        autoMounts = true
        cacheDir  = '/lustre/imgge/containers/nxf_singularity_cache'
    }
}

process {

    withLabel: process_low {
        executor = 'local'
    }
    withLabel: process_medium {
        executor = 'slurm'
    }
    withLabel: process_high {
        executor = 'slurm'
        cpus   = { 16    * task.attempt }
    }
    withLabel: process_single {
        executor = 'local'
    }

    withName: 'FASTP' {
        // Trenutni pristup (--split_by_lines) generise jedan fajl po thread-u, sto dovodi do prevelikog broja malih fajlova.
        // Planiramo podelu prema velicini fajlova radi boljeg balansa opterecenja, koristeci --split opciju, gde se zadaje
        // fiksan broj izlaznih fajlova, nezavisno od broja thread-ova.

        ext.chunks = {
            def size = reads.collect { it.size() }.sum()

            return Math.ceil(size / 280 / params.split_fastq) as int
        }

        cpus     = { 6    * task.attempt }
        memory   = { 4.GB * task.attempt }
        maxForks = 12

        ext.args = {
            [
                params.length_required > 0     ? "--length_required ${params.length_required}": '', // Reads shorter will be discarded
                task.ext.chunks > 1 ? "--split ${task.ext.chunks}" : '',
                '--overrepresentation_analysis',
                '--qualified_quality_phred 20',
                '--unqualified_percent_limit 30',
                '--average_qual 25',
                '--adapter_sequence=AAGTCGGAGGCCAAGCGGTCTTAGGAAGACAA',
                '--adapter_sequence_r2=AAGTCGGATCGTAGCCATGTCGTTCTGTGAGCCAAGGAGTTG',
                '--cut_right_window_size 4',
                '--cut_right_mean_quality 20',
                '--cut_right'
            ].join(' ').trim()
        }
    }

    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus     = { 16    * task.attempt }
        memory   = { 24.GB * task.attempt }
        maxForks = 8
    }

    withName: '.*:BAM_MERGE_INDEX_SAMTOOLS:MERGE_BAM' {
        executor = 'slurm'
        cpus     = { 6     * task.attempt }
        memory   = { 32.GB * task.attempt }
        maxForks = 2
    }

    withName: 'BAM_TO_CRAM_MAPPING' {
        publishDir = [
            [
                path: { params.cram_dir ?: "${params.outdir}/preprocessing/mapped/${meta.id}/" },
                mode: 'copy',
                pattern: "*{cram,crai}"
            ]
        ]
    }

    withName:"DEEPVARIANT_RUNDEEPVARIANT" {
        cpus = 48
        memory = 144.GB
        maxForks = 2
        clusterOptions = { " --gres=gpu:1" }
        containerOptions = '--nv -B /usr/local/cuda-12.8:/usr/local/cuda-12.8 --env LD_LIBRARY_PATH="/usr/local/cuda-12.8/targets/x86_64-linux/lib:\$LD_LIBRARY_PATH"'
        container = 'docker.io/google/deepvariant:1.9.0-gpu'
    }

}
